@using TechStore.Entities.ViewModels
@using TechStore.Utilities
@model OrderVM

@{
    ViewBag.PageTitle = "إدارة الطلبات";
    ViewBag.CardTitle = "تفاصيل الفاتورة والتشغيل";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<form method="post">
    <input hidden asp-for="OrderHeader.Id" />
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 col-lg-7 pb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3">
                        <h6 class="m-0 font-weight-bold text-primary">
                            <i class="fas fa-truck-loading me-2"></i> تفاصيل الاستلام والشحن
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">اسم المستلم</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light"><i class="fas fa-user text-muted"></i></span>
                                    <input asp-for="OrderHeader.Name" class="form-control shadow-none" />
                                </div>
                                <span asp-validation-for="OrderHeader.Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small">رقم الهاتف</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light"><i class="fas fa-phone text-muted"></i></span>
                                    <input asp-for="OrderHeader.PhoneNumber" class="form-control shadow-none" />
                                </div>
                                <span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold small">العنوان بالكامل</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light"><i class="fas fa-map-marker-alt text-muted"></i></span>
                                    <input asp-for="OrderHeader.Address" class="form-control shadow-none" />
                                </div>
                                <span asp-validation-for="OrderHeader.Address" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small">المدينة</label>
                                <input asp-for="OrderHeader.City" class="form-control form-control-sm shadow-none" />
                                <span asp-validation-for="OrderHeader.City" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small">البريد الإلكتروني</label>
                                <input asp-for="OrderHeader.ApplicationUser.Email" readonly class="form-control form-control-sm bg-light" />
                            </div>

                            <hr class="my-3 text-muted" />

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-primary">شركة الشحن (Carrier)</label>
                                <input asp-for="OrderHeader.Carrier" id="carrier" class="form-control form-control-sm border-primary shadow-none" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-primary">رقم التتبع (Tracking)</label>
                                <input asp-for="OrderHeader.TrakcingNumber" id="tracking" class="form-control form-control-sm border-primary shadow-none" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold small">تاريخ الطلب</label>
                                <input value="@Model.OrderHeader.OrderDate.ToShortDateString()" readonly class="form-control form-control-sm bg-light" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">تاريخ الشحن</label>
                                <input value="@Model.OrderHeader.ShippingDate.ToShortDateString()" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">حالة الدفع</label>
                                <input asp-for="OrderHeader.PaymentStatus" class="form-control form-control-sm fw-bold text-success" />
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 py-3">
                        <button type="submit" asp-action="UpdateOrderDetails" class="btn btn-primary btn-sm w-100 fw-bold shadow-sm">
                            <i class="fas fa-sync-alt me-2"></i> تحديث بيانات التوصيل
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5 pb-4">
                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-header bg-white py-3">
                        <h6 class="m-0 font-weight-bold text-primary">
                            <i class="fas fa-receipt me-2"></i> ملخص المنتجات
                        </h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="px-3 py-2 bg-light d-flex justify-content-between align-items-center">
                            <span class="small fw-bold text-muted">حالة الطلب الحالية:</span>
                            <span class="badge bg-soft-info text-info border border-info rounded-pill px-3">
                                @Model.OrderHeader.OrderStatus
                            </span>
                        </div>
                        <ul class="list-group list-group-flush overflow-auto" style="max-height: 400px;">
                            @foreach (var item in Model.OrderDetails)
                            {
                                <li class="list-group-item py-3">
                                    <div class="row align-items-center">
                                        <div class="col-8">
                                            <h6 class="mb-0 fw-bold text-dark">@item.Product.Name</h6>
                                            <div class="small text-muted">
                                                <span>السعر: @item.Product.Price.ToString("c")</span> |
                                                <span>الكمية: @item.Count</span>
                                            </div>
                                        </div>
                                        <div class="col-4 text-end">
                                            <span class="fw-bold text-primary">@((item.Count * item.Price).ToString("c"))</span>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="card-footer bg-dark py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="text-white mb-0 fw-bold">إجمالي الفاتورة</h5>
                            <h5 class="text-warning mb-0 fw-bold">@(Model.OrderHeader.TotalPrice.ToString("c"))</h5>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        @if (Model.OrderHeader.OrderStatus == SD.Approve)
                        {
                            <button type="submit" asp-action="StartProccess" class="btn btn-info w-100 mb-2 fw-bold text-white shadow-sm">
                                <i class="fas fa-cog fa-spin me-2"></i> بدء التجهيز (Proccessing)
                            </button>
                        }
                        @if (Model.OrderHeader.OrderStatus == SD.Proccessing)
                        {
                            <button type="submit" asp-action="StartShip" onclick="return CheckData()" class="btn btn-success w-100 mb-2 fw-bold shadow-sm">
                                <i class="fas fa-truck me-2"></i> شحن الطلب الآن
                            </button>
                        }
                        @if (Model.OrderHeader.OrderStatus != SD.Cancelled && Model.OrderHeader.OrderStatus != SD.Refund)
                        {
                            <button type="submit" asp-action="CancelOrder" class="btn btn-outline-danger w-100 fw-bold border-2">
                                <i class="fas fa-ban me-2"></i> إلغاء الطلب بالكامل
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function CheckData() {
            if (document.getElementById("carrier").value == '') {
                Swal.fire({
                    title: 'بيانات ناقصة',
                    text: "يرجى إدخال اسم شركة الشحن قبل المتابعة",
                    icon: 'warning',
                    confirmButtonColor: '#3085d6'
                });
                return false;
            }
            if (document.getElementById("tracking").value == '') {
                Swal.fire({
                    title: 'بيانات ناقصة',
                    text: "يرجى إدخال رقم تتبع الشحنة",
                    icon: 'warning',
                    confirmButtonColor: '#3085d6'
                });
                return false;
            }
            return true;
        }
    </script>
}