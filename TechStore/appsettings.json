{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=TechStore;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;Encrypt=False"
  },
  "stripe": {
    "secretkey": "YOUR_STRIPE_SECRET_KEY",
    "publishablekey": "YOUR_STRIPE_PUBLISHABLE_KEY"
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "YOUR_GMAIL@gmail.com",
    "SenderName": "TechStore",
    "Password": "YOUR_GMAIL_APP_PASSWORD"
  }
}
