@{
    ViewBag.PageTitle = "إدارة الطلبات";
    ViewBag.CardTitle = "قائمة الطلبات المستلمة";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<div class="container-fluid">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <h5 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-shipping-fast me-2"></i> متابعة حركة المبيعات
                </h5>
                <div class="btn-group">
                    <button class="btn btn-outline-secondary btn-sm">الكل</button>
                    <button class="btn btn-outline-primary btn-sm">قيد التنفيذ</button>
                    <button class="btn btn-outline-success btn-sm">تم التوصيل</button>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="mytable" class="table table-hover align-middle" width="100%">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="border-0">رقم الطلب</th>
                            <th class="border-0">العميل</th>
                            <th class="border-0">رقم الهاتف</th>
                            <th class="border-0">البريد الإلكتروني</th>
                            <th class="border-0">حالة الطلب</th>
                            <th class="border-0">الإجمالي</th>
                            <th class="border-0 text-center">الإجراءات</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/order.js"></script>
}