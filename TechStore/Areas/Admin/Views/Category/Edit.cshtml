@using TechStore.Entities.Models
@model Category

@{
    ViewBag.PageTitle = "إدارة الأقسام";
    ViewBag.CardTitle = "تعديل بيانات القسم";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-edit me-2"></i> تعديل القسم: <span class="text-dark">@Model.Name</span>
                    </h6>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input hidden asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-4">
                            <label asp-for="Name" class="form-label fw-bold small">اسم القسم</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="fas fa-folder-open"></i>
                                </span>
                                <input asp-for="Name" class="form-control border-start-0 shadow-none" placeholder="أدخل اسم القسم..." />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Description" class="form-label fw-bold small">الوصف</label>
                            <textarea id="mytextarea" asp-for="Description" class="form-control"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2 pt-2">
                            <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm">
                                <i class="fas fa-save me-2"></i> حفظ التغييرات
                            </button>
                            <a asp-action="Index" class="btn btn-light px-4 text-secondary border">
                                <i class="fas fa-arrow-left me-2"></i> العودة للقائمة
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // تخصيص محرر النصوص ليناسب المساحة
        tinymce.init({
            selector: '#mytextarea',
            height: 250,
            menubar: false,
            plugins: 'lists link',
            toolbar: 'undo redo | bold italic | alignleft aligncenter alignright | bullist numlist',
            content_style: 'body { font-family: Cairo,sans-serif; font-size:14px }'
        });
    </script>
}