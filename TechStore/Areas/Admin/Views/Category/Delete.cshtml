@using TechStore.Entities.Models
@model Category

@{
    ViewBag.PageTitle = "Categories Management";
    ViewBag.CardTitle = "Confirm Deletion";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="card shadow-sm border-0 mt-4">
                <div class="card-header bg-soft-danger py-3 text-center">
                    <h5 class="m-0 font-weight-bold text-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i> Are you sure?
                    </h5>
                </div>

                <div class="card-body p-4 text-center">
                    <p class="text-muted mb-4">You are about to permanently delete this category from the database. This action cannot be undone.</p>

                    <div class="bg-light rounded p-4 mb-4 text-start">
                        <div class="mb-3">
                            <label class="fw-bold small text-secondary d-block">Category Name</label>
                            <span class="h5 text-dark fw-bold">@Model.Name</span>
                        </div>
                        <div class="mb-0">
                            <label class="fw-bold small text-secondary d-block">Description</label>
                            <div class="text-muted">@Html.Raw(Model.Description)</div>
                        </div>
                    </div>

                    <form asp-action="DeleteCategory" method="post">
                        <input hidden asp-for="Id" />

                        <div class="d-grid gap-2 d-md-flex justify-content-center pt-2">
                            <button type="submit" class="btn btn-danger px-5 fw-bold shadow-sm">
                                <i class="fas fa-trash-alt me-2"></i> Yes, Delete
                            </button>
                            <a asp-action="Index" class="btn btn-light px-5 text-secondary border fw-bold">
                                <i class="fas fa-times me-2"></i> Cancel / Return
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}