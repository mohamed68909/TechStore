@using TechStore.Entities.ViewModels
@model ProductVM

@{
    ViewBag.PageTitle = "إدارة المنتجات";
    ViewBag.CardTitle = "تعديل بيانات المنتج";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<div class="container-fluid">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Product.Id" />
        <input type="hidden" asp-for="Product.Img" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3">
                        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-info-circle me-2"></i> معلومات المنتج</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="form-group col-md-6 mb-3">
                                <label asp-for="Product.Name" class="form-label fw-bold">اسم المنتج</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-tag text-muted"></i></span>
                                    <input asp-for="Product.Name" class="form-control shadow-none" placeholder="مثلاً: iPhone 15 Pro" />
                                </div>
                                <span asp-validation-for="Product.Name" class="text-danger small"></span>
                            </div>

                            <div class="form-group col-md-6 mb-3">
                                <label asp-for="Product.Price" class="form-label fw-bold">السعر (ج.م)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-money-bill-wave text-muted"></i></span>
                                    <input asp-for="Product.Price" class="form-control shadow-none" />
                                </div>
                                <span asp-validation-for="Product.Price" class="text-danger small"></span>
                            </div>

                            <div class="form-group col-12 mb-3">
                                <label asp-for="Product.CategoryId" class="form-label fw-bold">القسم</label>
                                <select asp-for="Product.CategoryId" class="form-select shadow-none" asp-items="Model.CategoryList">
                                    <option disabled selected>-- اختر القسم --</option>
                                </select>
                            </div>

                            <div class="form-group col-12 mb-3">
                                <label asp-for="Product.Description" class="form-label fw-bold">وصف المنتج</label>
                                <textarea id="mytextarea" asp-for="Product.Description" class="form-control"></textarea>
                                <span asp-validation-for="Product.Description" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3">
                        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-image me-2"></i> صورة المنتج</h6>
                    </div>
                    <div class="card-body text-center">
                        <div class="image-preview-container mb-3">
                            <img id="ImagePrevew" src="~/@Model.Product.Img" class="img-fluid rounded shadow-sm border" style="max-height: 250px; width: 100%; object-fit: contain;" />
                        </div>
                        <div class="form-group">
                            <label for="imgfile" class="btn btn-outline-primary btn-sm w-100">
                                <i class="fas fa-upload me-2"></i> تغيير الصورة
                                <input type="file" name="file" id="imgfile" class="form-control d-none" onchange="previewImage(event)" />
                            </label>
                            <small class="text-muted d-block mt-2">يفضل استخدام صور PNG بخلفية بيضاء</small>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <button type="submit" class="btn btn-success w-100 mb-2">
                            <i class="fas fa-save me-2"></i> حفظ التعديلات
                        </button>
                        <a asp-action="Index" class="btn btn-light w-100">
                            <i class="fas fa-arrow-left me-2"></i> العودة للقائمة
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // تفعيل محرر النصوص TinyMCE
        tinymce.init({
            selector: '#mytextarea',
            height: 300,
            plugins: 'lists link image preview',
            toolbar: 'undo redo | bold italic | alignleft aligncenter alignright | bullist numlist outdent indent'
        });

        // وظيفة معاينة الصورة فور اختيارها
        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function () {
                var output = document.getElementById('ImagePrevew');
                output.src = reader.result;
            }
            reader.readAsDataURL(event.target.files[0]);
        }
    </script>
}