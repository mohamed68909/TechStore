@{
    ViewBag.PageTitle = "Products Management";
    ViewBag.CardTitle = "Electronic Devices List";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<div class="container-fluid">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-boxes me-2"></i> Current Inventory
            </h5>
            <a class="btn btn-primary btn-sm px-4 shadow-sm" href="/Admin/Product/Create">
                <i class="fas fa-plus-circle"></i> Add New Product
            </a>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="mytable" class="table table-hover align-middle" width="100%">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="border-0">Product</th>
                            <th class="border-0">Description</th>
                            <th class="border-0">Price</th>
                            <th class="border-0">Category</th>
                            <th class="border-0 text-center">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/products.js"></script>
}