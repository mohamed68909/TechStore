@page
@model TechStore.Web.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }
        .forgot-card {
            background: white;
            padding: 40px;
            border-radius: 24px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            width: 100%;
            max-width: 450px;
            text-align: center;
        }
        .icon-box {
            width: 64px;
            height: 64px;
            background: #f1f5f9;
            color: #4f46e5;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin: 0 auto 24px;
        }
        .btn-reset {
            background: #4f46e5;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 12px;
            font-weight: 600;
            width: 100%;
            transition: all 0.3s;
        }
        .btn-reset:hover {
            background: #4338ca;
            transform: translateY(-1px);
        }
    </style>
</head>
<body>
    <div class="forgot-card">
        <div class="icon-box">
            <i class="bi bi-key-fill"></i>
        </div>
        <h2 class="fw-bold mb-2">Forgot Password?</h2>
        <p class="text-muted mb-4">No worries, we'll send you reset instructions.</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="text-start mb-4">
                <label asp-for="Input.Email" class="form-label small fw-bold">Email Address</label>
                <input asp-for="Input.Email" class="form-control form-control-lg rounded-3" placeholder="Enter your email" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn-reset shadow-sm">Send Reset Link</button>
        </form>

        <div class="mt-4">
            <a asp-page="./Login" class="text-decoration-none text-primary small fw-bold">Back to Login</a>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>
