@page
@using TechStore.Utilities
@model TechStore.Web.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Create Account | Premium";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<div class="auth-split-container">
    <!-- Side Panel (Desktop only) -->
    <div class="auth-image-side" style="background-image: url('/img/auth_bg_v2.png');">
        <div class="auth-image-content">
            <h1 class="display-3 fw-bold mb-3">Join the <span class="text-primary text-decoration-underline">Future</span></h1>
            <p class="lead opacity-75">Create your account now to start a unique shopping journey in the largest tech store.</p>
        </div>
    </div>

    <!-- Form Panel -->
    <div class="auth-form-side">
        <div class="auth-v2-card" style="max-width: 550px;">
            <div class="mb-4">
                <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="text-decoration-none d-block mb-3">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill small fw-bold">Back to Home</span>
                </a>
                <h2>Create Account</h2>
                <p class="auth-subtitle">Start your journey with us today step by step.</p>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="auth-v2-form">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-4 p-3 bg-danger-subtle rounded-3" role="alert"></div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-v2-group">
                            <label asp-for="Input.Name">Full Name</label>
                            <input asp-for="Input.Name" class="form-v2-control" placeholder="Your Full Name" autocomplete="Name" aria-required="true" />
                            <span asp-validation-for="Input.Name" class="text-danger small mt-1"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-v2-group">
                            <label asp-for="Input.City">City</label>
                            <input asp-for="Input.City" class="form-v2-control" placeholder="Cairo" autocomplete="City" aria-required="true" />
                            <span asp-validation-for="Input.City" class="text-danger small mt-1"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-v2-group">
                            <label asp-for="Input.Address">Address</label>
                            <input asp-for="Input.Address" class="form-v2-control" placeholder="Street, Neighborhood" autocomplete="Address" aria-required="true" />
                            <span asp-validation-for="Input.Address" class="text-danger small mt-1"></span>
                        </div>
                    </div>
                </div>

                <div class="form-v2-group">
                    <label asp-for="Input.Email">Email Address</label>
                    <input asp-for="Input.Email" class="form-v2-control" placeholder="name@example.com" autocomplete="username" aria-required="true" />
                    <span asp-validation-for="Input.Email" class="text-danger small mt-1"></span>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-v2-group">
                            <label asp-for="Input.Password">Password</label>
                            <div class="password-toggle-wrapper">
                                <input asp-for="Input.Password" class="form-v2-control password-input-with-toggle" id="password-field" placeholder="••••••••" autocomplete="new-password" aria-required="true" />
                                <i class="bi bi-eye-slash password-toggle-icon toggle-password" data-target="#password-field"></i>
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger small mt-1"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-v2-group">
                            <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                            <div class="password-toggle-wrapper">
                                <input asp-for="Input.ConfirmPassword" class="form-v2-control password-input-with-toggle" id="confirm-password-field" placeholder="••••••••" autocomplete="new-password" aria-required="true" />
                                <i class="bi bi-eye-slash password-toggle-icon toggle-password" data-target="#confirm-password-field"></i>
                            </div>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small mt-1"></span>
                        </div>
                    </div>
                </div>

                @if (User.IsInRole(SD.AdminRole))
                {
                    <div class="mb-4 p-4 border rounded-4 bg-light shadow-sm">
                        <p class="small fw-bold text-dark mb-3">User Roles (Admin Only):</p>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" value="@SD.AdminRole" name="RoleRadio" id="roleAdmin" />
                                <label class="form-check-label small fw-semibold" for="roleAdmin">Admin</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" value="@SD.EditorRole" name="RoleRadio" id="roleEditor" />
                                <label class="form-check-label small fw-semibold" for="roleEditor">Editor</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" value="@SD.CustomerRole" name="RoleRadio" id="roleCustomer" checked />
                                <label class="form-check-label small fw-semibold" for="roleCustomer">Customer</label>
                            </div>
                        </div>
                    </div>
                }

                <button id="registerSubmit" type="submit" class="auth-submit-btn">
                    <span>@(User.IsInRole(SD.AdminRole) ? "Create New Role" : "Sign Up for Free")</span>
                    <i class="bi bi-person-plus-fill ms-2"></i>
                </button>

                <div class="auth-v2-footer">
                    <p>Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in here</a></p>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<partial name="_ValidationScriptsPartial" />

<script>
    $(document).ready(function() {
        $(".toggle-password").click(function() {
            const targetSelector = $(this).attr("data-target");
            const passwordField = $(targetSelector);
            const type = passwordField.attr("type") === "password" ? "text" : "password";
            passwordField.attr("type", type);
            
            // Toggle icon
            $(this).toggleClass("bi-eye-slash bi-eye");
        });
    });
</script>
</body>
</html>
