@page
@model TechStore.Web.Areas.Identity.Pages.Account.VerifyOTPModel
@{
    ViewData["Title"] = "تفعيل الحساب";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/all.min.css" />
    <style>
        :root {
            --primary-color: #4f46e5;
            --primary-hover: #4338ca;
            --bg-glass: rgba(255, 255, 255, 0.9);
        }

        body {
            font-family: 'Outfit', 'Cairo', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            overflow: hidden;
        }

        .otp-card {
            background: var(--bg-glass);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            padding: 40px;
            width: 100%;
            max-width: 450px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            text-align: center;
            animation: slideUp 0.6s ease-out;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .icon-circle {
            width: 80px;
            height: 80px;
            background: #eef2ff;
            color: var(--primary-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin: 0 auto 24px;
        }

        .otp-inputs {
            display: flex;
            gap: 12px;
            justify-content: center;
            margin: 30px 0;
        }

        .otp-input {
            width: 50px;
            height: 60px;
            text-align: center;
            font-size: 24px;
            font-weight: 700;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            background: white;
            transition: all 0.3s ease;
        }

        .otp-input:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
            outline: none;
        }

        .btn-verify {
            background: var(--primary-color);
            color: white;
            border: none;
            padding: 14px 40px;
            border-radius: 12px;
            font-weight: 600;
            width: 100%;
            transition: all 0.3s;
            margin-top: 10px;
        }

        .btn-verify:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.4);
        }

        .resend-text {
            margin-top: 24px;
            color: #64748b;
            font-size: 0.9rem;
        }

        .resend-link {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="otp-card">
        <div class="icon-circle">
            <i class="fas fa-shield-alt"></i>
        </div>
        <h2 class="fw-bold mb-2">تفعيل الحساب</h2>
        <p class="text-muted">لقد أرسلنا رمز التفعيل إلى بريدك الإلكتروني <b>@Model.Email</b></p>
        
        <form method="post">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="OTP" id="fullOTP" />
            
            <div class="otp-inputs">
                <input type="text" maxlength="1" class="otp-input" oninput="moveNext(this, 1)" onkeydown="moveBack(this, 1)">
                <input type="text" maxlength="1" class="otp-input" oninput="moveNext(this, 2)" onkeydown="moveBack(this, 2)">
                <input type="text" maxlength="1" class="otp-input" oninput="moveNext(this, 3)" onkeydown="moveBack(this, 3)">
                <input type="text" maxlength="1" class="otp-input" oninput="moveNext(this, 4)" onkeydown="moveBack(this, 4)">
                <input type="text" maxlength="1" class="otp-input" oninput="moveNext(this, 5)" onkeydown="moveBack(this, 5)">
                <input type="text" maxlength="1" class="otp-input" oninput="moveNext(this, 6)" onkeydown="moveBack(this, 6)">
            </div>

            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <button type="submit" class="btn btn-verify shadow">تأكيد الرمز</button>
        </form>

        <div class="resend-text">
            لم يصلك الرمز؟ <a href="#" class="resend-link">إعادة الإرسال</a>
        </div>
    </div>

    <script>
        function moveNext(el, nextId) {
            if (el.value.length === 1 && nextId < 6) {
                el.nextElementSibling.focus();
            }
            updateFullOTP();
        }

        function moveBack(el, prevId) {
            if (event.key === "Backspace" && el.value.length === 0 && prevId > 1) {
                el.previousElementSibling.focus();
            }
        }

        function updateFullOTP() {
            const inputs = document.querySelectorAll('.otp-input');
            let otp = '';
            inputs.forEach(input => otp += input.value);
            document.getElementById('fullOTP').value = otp;
        }
    </script>
</body>
</html>
