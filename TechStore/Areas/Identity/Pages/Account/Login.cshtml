@page
@model TechStore.Web.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Login | Premium";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<div class="auth-split-container">
    <!-- Side Panel (Desktop only) -->
    <div class="auth-image-side" style="background-image: url('/img/auth_bg_v2.png');">
        <div class="auth-image-content">
            <h1 class="display-3 fw-bold mb-3">Welcome to the world of <span class="text-primary text-decoration-underline">Innovation</span></h1>
            <p class="lead opacity-75">Discover the latest tech products at the best prices and highest quality in TechStore.</p>
        </div>
    </div>

    <!-- Form Panel -->
    <div class="auth-form-side">
        <div class="auth-v2-card">
            <div class="mb-5">
                <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="text-decoration-none d-block mb-3">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill small fw-bold">Back to Home</span>
                </a>
                <h2>Login</h2>
                <p class="auth-subtitle">Enter your details to access your account and manage your purchases.</p>
            </div>

            <form id="account" method="post" class="auth-v2-form">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-4 p-3 bg-danger-subtle rounded-3" role="alert"></div>

                <div class="form-v2-group">
                    <label asp-for="Input.Email">Email Address</label>
                    <input asp-for="Input.Email" class="form-v2-control" placeholder="name@example.com" autocomplete="username" aria-required="true" />
                    <span asp-validation-for="Input.Email" class="text-danger small mt-1"></span>
                </div>

                <div class="form-v2-group">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Input.Password" class="mb-0">Password</label>
                        <a id="forgot-password" asp-page="./ForgotPassword" class="small text-primary text-decoration-none fw-semibold">Forgot Password?</a>
                    </div>
                    <div class="password-toggle-wrapper">
                        <input asp-for="Input.Password" class="form-v2-control password-input-with-toggle" id="password-field" placeholder="••••••••" autocomplete="current-password" aria-required="true" />
                        <i class="bi bi-eye-slash password-toggle-icon toggle-password" data-target="#password-field"></i>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small mt-1"></span>
                </div>

                <div class="mb-4 d-flex align-items-center">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Input.RememberMe" id="flexCheckDefault" />
                        <label class="form-check-label small text-muted ms-2" for="flexCheckDefault">
                            Remember Me
                        </label>
                    </div>
                </div>

                <button id="login-submit" type="submit" class="auth-submit-btn">
                    <span>Secure Login</span>
                    <i class="bi bi-shield-lock-fill ms-2"></i>
                </button>

                <div class="social-placeholder">
                    <p class="small text-muted mb-0">Or log in with</p>
                    <div class="social-btn-group">
                        <a href="#" class="social-icon-btn"><i class="bi bi-google"></i></a>
                        <a href="#" class="social-icon-btn"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-icon-btn"><i class="bi bi-apple"></i></a>
                    </div>
                </div>

                <div class="auth-v2-footer">
                    <p>Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Sign up for free now</a></p>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<partial name="_ValidationScriptsPartial" />

<script>
    $(document).ready(function() {
        $(".toggle-password").click(function() {
            const targetSelector = $(this).attr("data-target");
            const passwordField = $(targetSelector);
            const type = passwordField.attr("type") === "password" ? "text" : "password";
            passwordField.attr("type", type);
            
            // Toggle icon
            $(this).toggleClass("bi-eye-slash bi-eye");
        });
    });
</script>
</body>
</html>
