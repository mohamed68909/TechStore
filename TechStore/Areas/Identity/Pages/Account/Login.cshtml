@page
@model TechStore.Web.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "تسجيل الدخول | Premium";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Cairo:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<div class="auth-split-container">
    <!-- Side Panel (Desktop only) -->
    <div class="auth-image-side" style="background-image: url('/img/auth_bg_v2.png');">
        <div class="auth-image-content">
            <h1 class="display-3 fw-bold mb-3">مرحباً بك في عالم <span class="text-primary text-decoration-underline">الابتكار</span></h1>
            <p class="lead opacity-75">اكتشف أحدث المنتجات التقنية بأفضل الأسعار وأعلى جودة في TechStore.</p>
        </div>
    </div>

    <!-- Form Panel -->
    <div class="auth-form-side">
        <div class="auth-v2-card">
            <div class="mb-5">
                <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="text-decoration-none d-block mb-3">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill small fw-bold">العودة للرئيسية</span>
                </a>
                <h2>تسجيل الدخول</h2>
                <p class="auth-subtitle">أدخل بياناتك للوصول إلى حسابك وإدارة مشترياتك.</p>
            </div>

            <form id="account" method="post" class="auth-v2-form">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-4 p-3 bg-danger-subtle rounded-3" role="alert"></div>

                <div class="form-v2-group">
                    <label asp-for="Input.Email">البريد الإلكتروني</label>
                    <input asp-for="Input.Email" class="form-v2-control" placeholder="name@example.com" autocomplete="username" aria-required="true" />
                    <span asp-validation-for="Input.Email" class="text-danger small mt-1"></span>
                </div>

                <div class="form-v2-group">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Input.Password" class="mb-0">كلمة المرور</label>
                        <a id="forgot-password" asp-page="./ForgotPassword" class="small text-primary text-decoration-none fw-semibold">نسيت الكلمة؟</a>
                    </div>
                    <input asp-for="Input.Password" class="form-v2-control" placeholder="••••••••" autocomplete="current-password" aria-required="true" />
                    <span asp-validation-for="Input.Password" class="text-danger small mt-1"></span>
                </div>

                <div class="mb-4 d-flex align-items-center">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Input.RememberMe" id="flexCheckDefault" />
                        <label class="form-check-label small text-muted ms-2" for="flexCheckDefault">
                            تذكر تسجيل دخولي
                        </label>
                    </div>
                </div>

                <button id="login-submit" type="submit" class="auth-submit-btn">
                    <span>دخول آمن</span>
                    <i class="bi bi-shield-lock-fill ms-2"></i>
                </button>

                <div class="social-placeholder">
                    <p class="small text-muted mb-0">أو سجل دخولك عبر</p>
                    <div class="social-btn-group">
                        <a href="#" class="social-icon-btn"><i class="bi bi-google"></i></a>
                        <a href="#" class="social-icon-btn"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-icon-btn"><i class="bi bi-apple"></i></a>
                    </div>
                </div>

                <div class="auth-v2-footer">
                    <p>ليس لديك حساب؟ <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">اشترك مجاناً الآن</a></p>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<partial name="_ValidationScriptsPartial" />

</body>
</html>
