@model IEnumerable<OrderHeader>
@using TechStore.Utilities

@{
    ViewData["Title"] = "My Orders";
}

<style>
    .order-card {
        border: none;
        border-radius: 15px;
        transition: 0.3s;
        background: white;
    }

        .order-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important;
        }

    .status-badge {
        padding: 5px 15px;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 700;
    }
</style>

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12 text-center text-md-start">
            <h3 class="fw-bold"><i class="bi bi-bag-check me-2 text-primary"></i>Order History</h3>
            <p class="text-muted">Track your current and past orders easily</p>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 shadow-sm bg-white rounded-4 border-0">
            <i class="bi bi-box-seam text-light" style="font-size: 4rem; color: #e2e8f0;"></i>
            <h4 class="mt-3 text-muted">No orders in your account yet</h4>
            <p class="text-muted mb-4">Discover the latest tech offers and add them to your cart!</p>
            <a href="/" class="btn btn-primary rounded-pill px-5 shadow-sm fw-bold">Start Shopping Now</a>
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded-4 bg-white">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3">Order ID</th>
                        <th>Date</th>
                        <th>Total</th>
                        <th>Order Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark">#@item.Id</td>
                            <td>@item.OrderDate.ToString("yyyy/MM/dd")</td>
                            <td class="text-primary fw-bold">@item.TotalPrice.ToString("c")</td>
                            <td>
                                @if (item.OrderStatus == SD.Approve)
                                {
                                    <span class="status-badge bg-success text-white">Approved</span>
                                }
                                else if (item.OrderStatus == SD.Processing) @* FIX 11: was SD.Proccessing *@
                                {
                                    <span class="status-badge bg-info text-dark">Processing</span>
                                }
                                else if (item.OrderStatus == SD.Shipped)
                                {
                                    <span class="status-badge bg-primary text-white">Shipped</span>
                                }
                                else if (item.OrderStatus == SD.Cancelled)
                                {
                                    <span class="status-badge bg-danger text-white">Cancelled</span>
                                }
                                else
                                {
                                    <span class="status-badge bg-secondary text-white">@item.OrderStatus</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-orderid="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold">
                                    <i class="bi bi-eye me-1"></i> Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>