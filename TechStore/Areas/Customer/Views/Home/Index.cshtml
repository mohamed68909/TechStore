@using X.PagedList
@using X.PagedList.Mvc.Core

@model IPagedList<TechStore.Entities.Models.Product> 

@{
    ViewData["Title"] = "Electronics Store";
}

<style>
    /* Product Card Styling */
    .product-grid-card {
        border: none;
        border-radius: 20px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        background: white;
        overflow: hidden;
    }

    .product-grid-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.08);
    }

    /* Image Container */
    .img-container {
        position: relative;
        background-color: #f8fafc; /* Placeholder background color */
        height: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        overflow: hidden;
    }

    .img-container img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        transition: transform 0.5s ease, opacity 0.5s ease-in-out;
        opacity: 0; /* Image starts hidden */
    }

    /* Fade in effect when image loads */
    .img-container img[src] {
        opacity: 1;
    }

    .product-grid-card:hover .img-container img {
        transform: scale(1.1);
    }

    /* Product Details */
    .product-info {
        padding: 1.5rem;
    }

    .product-name {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 0.5rem;
        height: 2.8rem; 
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .product-price {
        font-size: 1.25rem;
        font-weight: 800;
        color: #2563eb;
    }

    .btn-view {
        border-radius: 12px;
        font-weight: 700;
        padding: 10px 20px;
        transition: 0.3s;
    }

    /* Pagination Styling */
    .pagination-container {
        margin-top: 4rem;
        margin-bottom: 2rem;
    }

    .pagination .page-item .page-link {
        border: none;
        margin: 0 5px;
        border-radius: 10px;
        color: #475569;
        font-weight: 600;
        padding: 10px 18px;
    }

    .pagination .page-item.active .page-link {
        background-color: #2563eb;
        color: white;
        box-shadow: 0 4px 10px rgba(37, 99, 235, 0.3);
    }
</style>

<section class="py-5">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gy-5 justify-content-center">
            @foreach (var item in Model)
            {
                <div class="col-6 col-md-4 col-xl-3">
                    <div class="product-grid-card h-100 shadow-sm">
                        <div class="img-container">
                            <a asp-action="Details" asp-route-ProductId="@item.Id">
                                @* Add loading="lazy" to defer image loading *@
                                <img src="/@item.Img.TrimStart('/')" alt="@item.Name" loading="lazy" />
                            </a>
                            <span class="position-absolute top-0 start-0 m-3 badge rounded-pill bg-primary shadow-sm" style="font-size: 0.7rem;">New</span>
                        </div>

                        <div class="product-info text-center">
                            <h5 class="product-name">@item.Name</h5>
                            <div class="product-price mb-3">
                                @item.Price.ToString("c")
                            </div>
                            
                            <div class="d-grid">
                                <a asp-action="Details" asp-route-ProductId="@item.Id" class="btn btn-outline-primary btn-view">
                                    <i class="bi bi-eye me-1"></i> View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="row pagination-container">
            <div class="col-12 d-flex justify-content-center">
                @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page }),
                    new PagedListRenderOptions {
                        LiElementClasses = new string[] { "page-item" },
                        PageClasses = new string[] { "page-link" },
                        DisplayLinkToFirstPage = PagedListDisplayMode.Never,
                        DisplayLinkToLastPage = PagedListDisplayMode.Never,
                        DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                        DisplayLinkToNextPage = PagedListDisplayMode.Always,
                        MaximumPageNumbersToDisplay = 5
                    })
            </div>
        </div>
    </div>
</section>