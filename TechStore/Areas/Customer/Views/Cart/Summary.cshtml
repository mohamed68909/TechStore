@model ShoppingCartVM
@using Microsoft.Extensions.Options
@inject IOptions<TechStore.Utilities.StripeData> Stripe

@{
    ViewData["Title"] = "Checkout";
}

<style>
    .checkout-container {
        padding-top: 3rem;
        padding-bottom: 5rem;
    }

    .checkout-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    /* Input Styling */
    .form-label {
        font-weight: 700;
        font-size: 0.85rem;
        color: #475569;
    }

    .input-group-text {
        background-color: #f8fafc;
        border-right: none;
        color: #94a3b8;
    }

    .form-control {
        border-left: none;
        padding: 10px;
        font-size: 0.9rem;
    }

        .form-control:focus {
            box-shadow: none;
            border-color: #dee2e6;
        }

    /* Cart Summary */
    .summary-item {
        border-bottom: 1px dashed #e2e8f0;
        padding: 15px 0;
    }

        .summary-item:last-child {
            border-bottom: none;
        }

    .product-thumb {
        width: 60px;
        height: 60px;
        object-fit: contain;
        background: #f1f5f9;
        border-radius: 10px;
        padding: 5px;
    }

    .badge-qty {
        position: absolute;
        top: -5px;
        right: -5px;
        background: #2563eb;
        color: white;
        border-radius: 50%;
        width: 22px;
        height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: bold;
    }

    .total-box {
        background: #0f172a;
        color: white;
        border-radius: 15px;
        padding: 20px;
    }

    .btn-place-order {
        background: linear-gradient(to right, #2563eb, #1e40af);
        border: none;
        padding: 15px;
        border-radius: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        transition: 0.3s;
    }

        .btn-place-order:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(37, 99, 235, 0.3);
        }
</style>

<div class="container checkout-container">
    <form method="post">
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card checkout-card">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-geo-alt me-2 text-primary"></i>Shipping & Receiving Details</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Full Name</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input asp-for="OrderHeader.Name" class="form-control" placeholder="Enter recipient name" />
                                </div>
                                <span asp-validation-for="OrderHeader.Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Phone Number</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-phone"></i></span>
                                    <input asp-for="OrderHeader.PhoneNumber" class="form-control" placeholder="e.g. 1234567890" />
                                </div>
                                <span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">City</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-building"></i></span>
                                    <input asp-for="OrderHeader.City" class="form-control" placeholder="e.g. New York" />
                                </div>
                                <span asp-validation-for="OrderHeader.City" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Detailed Address</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-map"></i></span>
                                    <input asp-for="OrderHeader.Address" class="form-control" placeholder="Street number, Building, Apartment" />
                                </div>
                                <span asp-validation-for="OrderHeader.Address" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mt-4 p-3 rounded-3 bg-light border">
                            <small class="text-muted"><i class="bi bi-shield-lock me-2 text-success"></i>Your information is protected and encrypted with the highest technical security standards.</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card checkout-card h-100">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark">Order Summary</h5>
                        <a href="/Customer/Cart/Index" class="btn btn-link btn-sm text-decoration-none fw-bold">Edit Cart</a>
                    </div>
                    <div class="card-body p-4">
                        <div class="order-items-list mb-4" style="max-height: 350px; overflow-y: auto;">
                            @foreach (var item in Model.CartsList)
                            {
                                <div class="summary-item d-flex align-items-center">
                                    <div class="position-relative me-3">
                                        <img src="~/@item.Product.Img" class="product-thumb" />
                                        <span class="badge-qty">@item.Count</span>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0 fw-bold small text-dark">@item.Product.Name</h6>
                                        <small class="text-muted">Unit Price: @item.Product.Price.ToString("c")</small>
                                    </div>
                                    <div class="fw-bold text-dark small">
                                        @((item.Product.Price * item.Count).ToString("c"))
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="total-box mt-auto shadow">
                            <div class="d-flex justify-content-between align-items-center mb-2 opacity-75">
                                <span>Subtotal</span>
                                <span>@Model.OrderHeader.TotalPrice.ToString("c")</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="fw-bold">Total Amount</span>
                                <h3 class="mb-0 fw-bold">@Model.OrderHeader.TotalPrice.ToString("c")</h3>
                            </div>
                            <button type="submit" class="btn btn-primary btn-place-order w-100 shadow-lg text-white">
                                Confirm Order & Pay <i class="bi bi-credit-card ms-2"></i>
                            </button>
                        </div>

                        <div class="text-center mt-3">
                            <a href="/Customer/Home" class="text-muted small text-decoration-none">
                                <i class="bi bi-arrow-left me-1"></i> Back to Shopping
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}