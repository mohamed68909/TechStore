@model int

@{
    ViewData["Title"] = "تم الطلب بنجاح";
}

<style>
    .confirm-container {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 0;
    }

    .confirm-card {
        border: none;
        border-radius: 30px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.05);
        background: white;
        padding: 3rem;
        max-width: 600px;
        width: 100%;
        text-align: center;
    }

    /* تأثير أيقونة النجاح */
    .success-icon-wrapper {
        width: 100px;
        height: 100px;
        background: #d1fae5;
        color: #10b981;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3.5rem;
        margin: 0 auto 2rem;
        animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@keyframes scaleIn {
        from {
            transform: scale(0);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .order-badge {
        background: #f1f5f9;
        color: #0f172a;
        padding: 10px 20px;
        border-radius: 50px;
        font-weight: 700;
        font-family: 'Inter', sans-serif;
        display: inline-block;
        margin-top: 1rem;
    }

    .btn-home {
        background: #2563eb;
        border: none;
        border-radius: 12px;
        padding: 12px 30px;
        font-weight: 700;
        transition: 0.3s;
    }

        .btn-home:hover {
            background: #1d4ed8;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(37, 99, 235, 0.2);
        }

    .confetti-img {
        max-width: 250px;
        margin-bottom: 20px;
    }
</style>

<div class="confirm-container">
    <div class="confirm-card shadow">
        <div class="success-icon-wrapper">
            <i class="bi bi-check-circle-fill"></i>
        </div>

        <h1 class="fw-extrabold text-dark mb-2">شكراً لثقتك بنا!</h1>
        <p class="text-muted mb-4 lead">لقد تم استلام طلبك بنجاح وجاري الآن تجهيزه بكل حب وعناية.</p>

        <div class="py-3 border-top border-bottom mb-4">
            <span class="text-secondary d-block mb-1 small text-uppercase fw-bold">رقم الطلب الخاص بك</span>
            <div class="order-badge">
                #@Model
            </div>
        </div>

        <div class="mb-4">
            <img src="~/img/confirm.jpg" class="img-fluid rounded shadow-sm" style="max-height: 200px; object-fit: cover;" onerror="this.style.display='none'" />
        </div>

        <p class="small text-muted mb-4">سوف نرسل لك رسالة تأكيد على بريدك الإلكتروني قريباً تحتوي على كافة التفاصيل.</p>

        <div class="d-grid gap-2 d-sm-flex justify-content-center">
            <a href="/Customer/Home/Index" class="btn btn-primary btn-home shadow">
                <i class="bi bi-house-door me-2"></i>العودة للرئيسية
            </a>
            <a href="#" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                تتبع الطلب
            </a>
        </div>
    </div>
</div>