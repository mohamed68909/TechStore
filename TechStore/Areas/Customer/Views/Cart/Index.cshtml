@model ShoppingCartVM

@{
    ViewData["Title"] = "Shopping Cart";
}

<style>
    .cart-container {
        padding-top: 2rem;
        padding-bottom: 5rem;
    }

    .cart-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        background: white;
    }

    /* Cart item styling */
    .cart-item {
        transition: all 0.3s ease;
        padding: 1.5rem;
        border-bottom: 1px solid #f1f5f9;
    }

        .cart-item:last-child {
            border-bottom: none;
        }

    .product-img-wrapper {
        background-color: #f8fafc;
        border-radius: 15px;
        padding: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100px; /* Prevent layout shift during load */
    }

        .product-img-wrapper img {
            max-height: 100px;
            object-fit: contain;
            /* Smooth fade-in effect */
            opacity: 0;
            transition: opacity 0.5s ease-in-out;
        }

            /* Show image once loaded */
            .product-img-wrapper img[src] {
                opacity: 1;
            }

    /* Quantity controls styling */
    .qty-controls {
        background: #f1f5f9;
        border-radius: 10px;
        padding: 5px;
        display: inline-flex;
        align-items: center;
    }

    .btn-qty {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px !important;
        padding: 0;
        background: white;
        border: 1px solid #e2e8f0;
        color: #0f172a;
        transition: 0.2s;
    }

        .btn-qty:hover {
            background: #2563eb;
            color: white;
        }

    .qty-count {
        margin: 0 15px;
        font-weight: 700;
        color: #0f172a;
    }

    /* Cart summary */
    .cart-summary {
        background: #f8fafc;
        border-radius: 15px;
        padding: 20px;
    }

    .total-price {
        font-size: 1.5rem;
        font-weight: 800;
        color: #2563eb;
    }

    .btn-checkout {
        border-radius: 12px;
        padding: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
</style>

<div class="container cart-container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold mb-0"><i class="bi bi-cart3 me-2 text-primary"></i>Shopping Cart</h3>
                <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i>Continue Shopping
                </a>
            </div>

            <form method="post">
                <div class="card cart-card">
                    <div class="card-body p-0">
                        @if (Model.CartsList == null || !Model.CartsList.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
                                <h4 class="mt-3 text-muted">Your cart is empty</h4>
                                <p class="text-muted mb-4">Discover the latest offers and add some products!</p>
                                <a href="/Customer/Home/Index" class="btn btn-primary rounded-pill px-5">Start Shopping Now</a>
                            </div>
                        }
                        else
                        {
                            @foreach (var item in Model.CartsList)
                            {
                                <div class="cart-item">
                                    <div class="row align-items-center text-center text-lg-start">
                                        <div class="col-12 col-lg-2 mb-3 mb-lg-0">
                                            <div class="product-img-wrapper shadow-sm">
                                                @* Add lazy loading and Fade-in effect *@
                                                <img src="/@item.Product.Img.TrimStart('/')"
                                                     class="img-fluid"
                                                     loading="lazy"
                                                     onload="this.style.opacity='1'" />
                                            </div>
                                        </div>

                                        <div class="col-12 col-lg-4 mb-3 mb-lg-0">
                                            <h5 class="fw-bold text-dark mb-1">@item.Product.Name</h5>
                                            <div class="text-muted small text-truncate" style="max-width: 300px;">
                                                @Html.Raw(item.Product.Description)
                                            </div>
                                        </div>

                                        <div class="col-12 col-lg-4 mb-3 mb-lg-0">
                                            <div class="d-flex flex-column flex-lg-row align-items-center justify-content-center justify-content-lg-around">
                                                <div class="mb-3 mb-lg-0">
                                                    <span class="text-muted small d-block">Unit Price</span>
                                                    <span class="fw-bold">@item.Product.Price.ToString("c")</span>
                                                </div>

                                                <div class="qty-controls shadow-sm">
                                                    <a asp-action="minus" asp-route-cartId="@item.Id" class="btn btn-qty">
                                                        <i class="bi bi-dash"></i>
                                                    </a>
                                                    <span class="qty-count">@item.Count</span>
                                                    <a asp-action="plus" asp-route-cartId="@item.Id" class="btn btn-qty">
                                                        <i class="bi bi-plus"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 col-lg-2 text-lg-end">
                                            <div class="d-flex d-lg-block justify-content-between align-items-center">
                                                <div class="d-lg-none small text-muted">Total:</div>
                                                <div class="fw-bold text-primary mb-lg-2">@((item.Product.Price * item.Count).ToString("c"))</div>
                                                <a asp-action="remove" asp-route-cartId="@item.Id" class="btn btn-outline-danger btn-sm border-0 rounded-circle" title="Remove">
                                                    <i class="bi bi-trash3-fill"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="card-footer bg-white p-4 border-0">
                                <div class="row align-items-center">
                                    <div class="col-lg-7 text-muted small mb-3 mb-lg-0">
                                        <i class="bi bi-shield-check me-1 text-success"></i> 100% Secure Shopping | Tech Product Quality Guarantee
                                    </div>
                                    <div class="col-lg-5">
                                        <div class="cart-summary shadow-sm">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <span class="fw-bold text-muted">Cart Total:</span>
                                                <span class="total-price">@Model.OrderHeader.TotalPrice.ToString("c")</span>
                                            </div>
                                            <a asp-action="Summary" class="btn btn-primary btn-checkout w-100 shadow">
                                                Proceed to Checkout <i class="bi bi-arrow-right-circle ms-2"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>