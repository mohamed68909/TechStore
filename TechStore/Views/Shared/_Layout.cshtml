@using Microsoft.AspNetCore.Http
@using TechStore.Utilities
@inject IHttpContextAccessor httpContextAccessor

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyShop</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --primary-color: #2563eb;
            --dark-color: #0f172a;
            --light-bg: #f8fafc;
        }

        /* --- Sticky Footer Solution --- */
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--light-bg);
            /* Use Flexbox for vertical layout */
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        header {
            flex-shrink: 0; /* Prevent header from shrinking */
        }

        main {
            /* Make content take available space and push footer down */
            flex: 1 0 auto;
        }

        .site-footer {
            flex-shrink: 0; /* Prevent footer from shrinking */
            background-color: var(--dark-color);
            color: #94a3b8;
            padding: 40px 0 20px;
        }

        /* --- Glass Navbar Design --- */
        .navbar {
            background-color: rgba(255, 255, 255, 0.85) !important;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.8);
            padding: 0.8rem 0;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--dark-color) !important;
        }

            .navbar-brand span {
                color: var(--primary-color);
            }

        .nav-link {
            font-weight: 600;
            color: #475569 !important;
            transition: 0.2s;
        }

            .nav-link:hover {
                color: var(--primary-color) !important;
            }

        /* Cart Button */
        .btn-cart {
            background-color: var(--dark-color);
            color: white !important;
            border-radius: 12px;
            padding: 8px 18px;
            font-weight: 600;
            transition: 0.3s;
        }

            .btn-cart:hover {
                background-color: var(--primary-color);
                transform: translateY(-2px);
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light sticky-top shadow-sm">
            <div class="container">
                <a class="navbar-brand" asp-area="Customer" asp-controller="Home" asp-action="Index">MY<span>SHOP</span></a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Customer" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole(SD.AdminRole))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-primary fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-1"></i>Dashboard
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <partial name="_LoginPartial" />

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-area="Customer" asp-controller="Cart" asp-action="Index" class="btn btn-cart">
                                <i class="bi-cart-fill me-2"></i>
                                Cart
                                <span class="badge bg-primary ms-2 rounded-pill">
                                    @await Component.InvokeAsync("ShoppingCart")
                                </span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <span class="fw-bold text-white">MY<span>SHOP</span></span> &copy; @DateTime.Now.Year - All Rights Reserved
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <a asp-area="Customer" asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted me-3">Privacy Policy</a>
                    <div class="d-inline-flex gap-3 ms-3">
                        <i class="bi bi-facebook fs-5"></i>
                        <i class="bi bi-instagram fs-5"></i>
                        <i class="bi bi-twitter fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>