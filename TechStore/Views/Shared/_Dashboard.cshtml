<!DOCTYPE html>
<html lang="en">
<head>
   
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>myShop | Dashboard </title>

    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="/css/adminlte.min.css">

    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link rel="stylesheet" href="//cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css" />

    <style>
        :root {
            --primary-tech: #2563eb;
            --sidebar-bg: #0f172a;
            --content-bg: #f8fafc;
            --card-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }

        body {
            font-family: 'Inter', 'Cairo', sans-serif;
            background-color: var(--content-bg);
            color: #1e293b;
        }

        /* Avatar and Status Badges */
        .avatar-sm {
            height: 36px;
            width: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .avatar-title {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
        }
        .bg-soft-primary { background-color: rgba(37, 99, 235, 0.1) !important; }
        
        .badge-status-active {
            background-color: rgba(16, 185, 129, 0.1);
            color: #059669;
            padding: 6px 12px;
            border-radius: 6px;
            font-weight: 600;
        }
        .badge-status-locked {
            background-color: rgba(239, 68, 68, 0.1);
            color: #dc2626;
            padding: 6px 12px;
            border-radius: 6px;
            font-weight: 600;
        }
        .bg-soft-info { background-color: rgba(6, 182, 212, 0.1) !important; }

        .btn-action {
            width: 32px;
            height: 32px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px !important;
        }

        /* Customize Scrollbar to look modern */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }

        /* Sidebar */
        .main-sidebar {
            background-color: var(--sidebar-bg) !important;
            transition: all 0.3s ease;
        }

        .nav-pills .nav-link {
            border-radius: 8px;
            margin: 2px 10px;
            color: #94a3b8 !important;
            font-size: 0.95rem;
        }

            .nav-pills .nav-link:hover {
                background: rgba(255,255,255,0.05);
                color: #fff !important;
            }

        .nav-sidebar .nav-item .nav-link.active {
            background-color: var(--primary-tech) !important;
            color: #fff !important;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }

        /* Enhanced Navbar */
        .main-header {
            background-color: rgba(255, 255, 255, 0.8) !important;
            backdrop-filter: blur(10px); /* Frosted glass effect */
            border-bottom: 1px solid #e2e8f0 !important;
        }

        /* Cards */
        .card {
            border-radius: 16px !important;
            border: 1px solid #e2e8f0 !important;
            box-shadow: var(--card-shadow) !important;
            transition: transform 0.3s ease;
        }

        .card-header {
            border-bottom: 1px solid #f1f5f9 !important;
            padding: 1.25rem;
        }

        /* Enhanced Brand Styling */
        .brand-link {
            padding: 1.5rem 0.5rem !important;
            border-bottom: 1px solid rgba(255,255,255,0.1) !important;
            text-align: center;
        }

        .brand-text {
            letter-spacing: 2px;
            font-size: 1.2rem;
            text-transform: uppercase;
        }

        /* Enhanced Button Styling */
        .btn {
            border-radius: 10px !important;
            padding: 8px 16px;
            font-weight: 600;
        }

        /* Content Wrapper */
        .content-wrapper {
            background-color: var(--content-bg);
        }

        /* Beautify Tables */
        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background: var(--primary-tech) !important;
            border: none;
            border-radius: 6px;
            color: white !important;
        }
    </style>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">

        <nav class="main-header navbar navbar-expand navbar-white navbar-light sticky-top shadow-sm">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars text-primary"></i></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="/Customer/Home/Index" class="nav-link text-dark fw-bold border-start ms-2 ps-3">
                        <i class="fas fa-external-link-alt me-1"></i> Public Store
                    </a>
                </li>
            </ul>

            <ul class="navbar-nav ml-auto">
                <li class="nav-item dropdown">
                    <a class="nav-link" data-toggle="dropdown" href="#">
                        <i class="far fa-bell text-secondary"></i>
                        <span class="badge badge-danger navbar-badge shadow-sm">15</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt text-secondary"></i>
                    </a>
                </li>
            </ul>
        </nav>

        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="/" class="brand-link">
                <span class="brand-text font-weight-bold">
                    <i class="fas fa-bolt text-primary me-1"></i> MYSHOP <span class="text-primary">TECH</span>
                </span>
            </a>

            <div class="sidebar">
                <div class="user-panel mt-4 pb-4 mb-4 d-flex align-items-center justify-content-center border-bottom border-secondary">
                    <div class="image">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold shadow-sm border border-2 border-white" style="width: 40px; height: 40px;">
                            A
                        </div>
                    </div>
                    <div class="info">
                        <a href="#" class="d-block fw-bold text-white">Administrator</a>
                    </div>
                </div>

                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column nav-child-indent" data-widget="treeview" role="menu">
                        <li class="nav-header text-muted text-uppercase small" style="letter-spacing: 1px;">Main</li>
                        <li class="nav-item">
                            <a href="/Admin/Dashboard/Index" class="nav-link active">
                                <i class="nav-icon fas fa-chart-line"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>

                        <li class="nav-header text-muted text-uppercase small mt-3" style="letter-spacing: 1px;">Inventory Management</li>
                        <li class="nav-item">
                            <a href="/Admin/Category/Index" class="nav-link">
                                <i class="nav-icon fas fa-tags"></i>
                                <p>Categories</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/Product/Index" class="nav-link">
                                <i class="nav-icon fas fa-laptop-code"></i>
                                <p>Products</p>
                            </a>
                        </li>

                        <li class="nav-header text-muted text-uppercase small mt-3" style="letter-spacing: 1px;">Sales</li>
                        <li class="nav-item">
                            <a href="/Admin/Order/Index" class="nav-link">
                                <i class="nav-icon fas fa-shopping-bag"></i>
                                <p>Orders <span class="right badge badge-primary">@ViewBag.Orders</span></p>
                            </a>
                        </li>

                        <li class="nav-header text-muted text-uppercase small mt-3" style="letter-spacing: 1px;">Users</li>
                        <li class="nav-item">
                            <a href="/Admin/Users/Index" class="nav-link">
                                <i class="nav-icon fas fa-users"></i>
                                <p>Users Management <span class="right badge badge-success">@ViewBag.Users</span></p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <div class="content-wrapper px-4 py-3">
            <section class="content-header">
                <div class="container-fluid p-0">
                    <h1 class="font-weight-bold text-dark mb-4" style="font-size: 1.8rem;">@ViewBag.PageTitle</h1>
                </div>
            </section>

            <section class="content">
                <div class="container-fluid p-0">
                    <partial name="_Toaster" />
                    @RenderBody()
                </div>
            </section>
        </div>

        <footer class="main-footer bg-white border-top text-sm py-3">
            <div class="float-right d-none d-sm-block text-muted">
                System Version 1.2.5 <i class="fas fa-code-branch ms-1"></i>
            </div>
            <strong>Copyright &copy; @DateTime.Now.Year <span class="text-primary">MyShop Tech</span>.</strong> All rights reserved.
        </footer>
    </div>

    <script src="/plugins/jquery/jquery.min.js"></script>
    <script src="/plugins/jquery-ui/jquery-ui.min.js"></script>
    <script src="/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/adminlte.min.js"></script>
    <script src="//cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.2/tinymce.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>