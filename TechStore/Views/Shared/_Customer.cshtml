@using Microsoft.AspNetCore.Http
@using TechStore.Utilities

@inject IHttpContextAccessor httpContextAccessor

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>myShop | Best Tech Offers</title>

    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Inter:wght@400;700&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet" />

    <link href="~/customer/css/styles.css" rel="stylesheet" />

    <style>
        :root {
            --primary-color: #2563eb; /* Modern tech blue */
            --dark-color: #0f172a; /* Very dark navy */
            --light-bg: #f8fafc; /* Light comfortable background */
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: var(--light-bg);
            color: var(--dark-color);
        }

        /* Glass navbar */
        .navbar {
            background-color: rgba(255, 255, 255, 0.85) !important;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.8);
            padding: 0.8rem 0;
            transition: all 0.3s ease;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.5rem;
            letter-spacing: -0.5px;
            color: var(--dark-color) !important;
        }

            .navbar-brand span {
                color: var(--primary-color);
            }

        .nav-link {
            font-weight: 600;
            color: #475569 !important;
            margin: 0 5px;
            transition: 0.2s;
        }

            .nav-link:hover {
                color: var(--primary-color) !important;
            }

        /* Professional Cart Button */
        .btn-cart {
            background-color: var(--dark-color);
            color: white !important;
            border-radius: 12px;
            padding: 8px 18px;
            border: none;
            transition: 0.3s;
            display: flex;
            align-items: center;
            font-weight: 600;
        }

            .btn-cart:hover {
                background-color: var(--primary-color);
                transform: translateY(-2px);
                box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.2);
            }

        /* Hero Section - Welcome Interface */
        .hero-banner {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            padding: 120px 0;
            position: relative;
            clip-path: ellipse(150% 100% at 50% 0%); /* Modern curve below header */
        }

        .hero-title {
            font-size: 3.5rem;
            font-weight: 800;
            letter-spacing: -1px;
            background: linear-gradient(to right, #ffffff, #94a3b8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Enhanced Footer */
        .site-footer {
            background-color: var(--dark-color);
            color: #94a3b8;
            padding: 80px 0 30px;
        }

        .footer-heading {
            color: white;
            font-weight: 700;
            margin-bottom: 1.5rem;
        }

        .footer-link {
            color: #94a3b8;
            text-decoration: none;
            transition: 0.2s;
            display: block;
            margin-bottom: 0.8rem;
        }

            .footer-link:hover {
                color: white;
                padding-right: 5px;
            }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light sticky-top shadow-sm">
        <div class="container px-4 px-lg-5">
            <a class="navbar-brand" href="/Customer/Home/Index">MY<span>SHOP</span></a>
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    <li class="nav-item"><a class="nav-link active" href="/Customer/Home/Index">Home</a></li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole(SD.AdminRole))
                        {
                            <li class="nav-item"><a class="nav-link text-primary fw-bold" href="/Admin/Dashboard/Index"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" id="navbarDropdown" href="#" role="button" data-bs-toggle="dropdown">My Account</a>
                                <ul class="dropdown-menu border-0 shadow-lg mt-3" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item py-2" href="/Customer/Order/MyOrders"><i class="bi bi-bag-check me-2"></i>My Orders</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item py-2" href="/Identity/Account/Manage"><i class="bi bi-person-gear me-2"></i>Edit Profile</a></li>
                                </ul>
                            </li>
                        }
                    }
                </ul>

                <div class="d-flex align-items-center">
                    <partial name="_LoginPartial" />

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/Customer/Cart/Index" class="btn btn-cart ms-lg-3 mt-2 mt-lg-0">
                            <i class="bi-cart-fill me-2"></i>
                            Cart
                            <span class="badge bg-primary text-white ms-2 rounded-pill">
                                @await Component.InvokeAsync("ShoppingCart")
                            </span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    @{
        // Safe code to determine home page without Null error
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();
        var isHome = string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase);
    }

    @if (isHome)
    {
        <header class="hero-banner text-center text-white">
            <div class="container px-4 px-lg-5 my-5">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <h1 class="hero-title mb-3">A World of Tech Innovation</h1>
                        <p class="lead fw-normal text-white-50 mb-5">Discover the latest mobiles, watches, and smart devices with the best prices and strongest guarantees</p>
                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                            <a href="#products" class="btn btn-primary btn-lg px-5 rounded-pill fw-bold shadow">Shop Now</a>
                            <a href="#" class="btn btn-outline-light btn-lg px-5 rounded-pill fw-bold">Latest Offers</a>
                        </div>
                    </div>
                </div>
            </div>
        </header>
    }

    <main class="py-5" id="products">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4 col-md-6">
                    <h5 class="navbar-brand text-white mb-4">MY<span>SHOP</span></h5>
                    <p class="small lh-lg">We provide the best electronics shopping experience. Real quality, competitive prices, and 24/7 technical support.</p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="footer-heading small text-uppercase">Quick Links</h6>
                    <a href="#" class="footer-link">About Store</a>
                    <a href="#" class="footer-link">Privacy Policy</a>
                    <a href="#" class="footer-link">Terms of Use</a>
                </div>
                <div class="col-lg-3 col-md-6 text-center text-md-start">
                    <h6 class="footer-heading small text-uppercase">Contact Us</h6>
                    <p class="small mb-1">Alexandria, Egypt</p>
                    <p class="small mb-4 text-white">support@myshop.com</p>
                    <div class="d-flex gap-3 justify-content-center justify-content-md-start">
                        <a href="#" class="btn btn-outline-light btn-sm rounded-circle"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-outline-light btn-sm rounded-circle"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="btn btn-outline-light btn-sm rounded-circle"><i class="bi bi-whatsapp"></i></a>
                    </div>
                </div>
            </div>
            <hr class="my-5 border-secondary opacity-25" />
            <div class="text-center small">
                <p class="mb-0 text-muted">All rights reserved &copy; MyShop Tech @DateTime.Now.Year</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/customer/js/scripts.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>